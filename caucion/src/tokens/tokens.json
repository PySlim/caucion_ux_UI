  "component": {
    "radius-control":  { "value": "{radius.md}", "use": "Botones, inputs, selects, ítems de navegación y menú" },
    "radius-card":     { "value": "{radius.md}", "use": "Paneles, tarjetas, contenedores de tabla" },
    "radius-overlay":  { "value": "{radius.lg}", "use": "Modales, drawers, menús, popovers, toasts" },
    "radius-badge":    { "value": "{radius.sm}", "use": "Badges, tags, chips densos" },
    "radius-check":    { "value": "{radius.sm}", "use": "Checkbox" },
    "radius-tooltip":  { "value": "{radius.sm}", "use": "Tooltip" },
    "border-width":    { "value": "1px", "use": "Bordes de controles y paneles" },
    "focus-width":     { "value": "2px", "use": "Grosor del indicador de foco" },
    "focus-offset":    { "value": "2px", "use": "Separación del indicador de foco" },
    "shadow-card":     { "value": "0 1px 2px rgb(var(--shadow-color) / var(--shadow-alpha-1))", "use": "Paneles y tarjetas", "themed": true },
    "shadow-popover":  { "value": "0 4px 12px rgb(var(--shadow-color) / var(--shadow-alpha-2)), 0 1px 3px rgb(var(--shadow-color) / var(--shadow-alpha-1))", "use": "Menús, popovers, toasts", "themed": true },
    "shadow-modal":    { "value": "0 16px 40px rgb(var(--shadow-color) / var(--shadow-alpha-3)), 0 2px 6px rgb(var(--shadow-color) / var(--shadow-alpha-1))", "use": "Modales y drawers", "themed": true },
    "sidebar-w":       { "value": "248px", "use": "Sidebar expandido" },
    "sidebar-w-collapsed": { "value": "64px", "use": "Sidebar colapsado" },
    "topbar-h":        { "value": "56px", "use": "Topbar" },
    "modal-w-sm":      { "value": "420px", "use": "Confirmación" },
    "modal-w-md":      { "value": "560px", "use": "Modal estándar" },
    "modal-w-lg":      { "value": "760px", "use": "Decisión" },
    "modal-w-xl":      { "value": "960px", "use": "Formulario extenso" },
    "drawer-w":        { "value": "480px", "use": "Drawer" },
    "toast-w":         { "value": "360px", "use": "Toast" },
    "transition":      { "value": "{duration.fast}", "use": "Transición de color" }
  },

  "density": {
    "$description": "Balanced es la densidad oficial. Compact queda definida para una futura opción. Touch se aplica automáticamente bajo 768 px.",
    "balanced": { "control-h-sm": "32px", "control-h-md": "36px", "control-h-lg": "44px", "row-h": "48px", "row-h-dense": "40px", "nav-item-h": "40px", "menu-item-h": "36px", "tab-h": "44px", "panel-pad": "20px", "panel-head-h": "52px", "section-gap": "24px" },
    "compact":  { "control-h-sm": "28px", "control-h-md": "32px", "control-h-lg": "40px", "row-h": "44px", "row-h-dense": "36px", "nav-item-h": "36px", "menu-item-h": "32px", "tab-h": "40px", "panel-pad": "16px", "panel-head-h": "48px", "section-gap": "20px" },
    "touch":    { "control-h-sm": "36px", "control-h-md": "40px", "control-h-lg": "44px", "row-h": "48px", "nav-item-h": "44px", "menu-item-h": "40px", "tab-h": "44px", "panel-pad": "16px", "section-gap": "16px" }
  },

  "typography": {
    "$description": "Roles tipográficos. size/leading en rem para respetar el tamaño de texto del navegador.",
    "module":    { "size": "{font.size.12}", "leading": "{font.leading.16}", "weight": "{font.weight.semibold}", "tracking": "0.07em", "transform": "uppercase", "use": "Encabezado de módulo (eyebrow)" },
    "page":      { "size": "{font.size.22}", "leading": "{font.leading.28}", "weight": "{font.weight.semibold}", "tracking": "-0.01em", "mobileSize": "{font.size.20}", "mobileLeading": "{font.leading.26}", "use": "Título de página" },
    "section":   { "size": "{font.size.16}", "leading": "{font.leading.24}", "weight": "{font.weight.semibold}", "tracking": "0", "use": "Encabezado de sección" },
    "sub":       { "size": "{font.size.14}", "leading": "{font.leading.20}", "weight": "{font.weight.semibold}", "tracking": "0", "use": "Título de panel" },
    "body":      { "size": "{font.size.14}", "leading": "{font.leading.20}", "weight": "{font.weight.regular}", "tracking": "0", "use": "Cuerpo y formularios" },
    "label":     { "size": "{font.size.13}", "leading": "{font.leading.18}", "weight": "{font.weight.medium}", "tracking": "0", "use": "Etiquetas de campo" },
    "table":     { "size": "{font.size.13}", "leading": "{font.leading.18}", "weight": "{font.weight.regular}", "tracking": "0", "use": "Celdas de tabla" },
    "help":      { "size": "{font.size.12}", "leading": "{font.leading.16}", "weight": "{font.weight.regular}", "tracking": "0", "use": "Ayudas y notas" },
    "caption":   { "size": "{font.size.12}", "leading": "{font.leading.16}", "weight": "{font.weight.medium}", "tracking": "0", "use": "Estados y notificaciones" },
    "amount-lg": { "size": "{font.size.24}", "leading": "{font.leading.32}", "weight": "{font.weight.semibold}", "tracking": "-0.01em", "use": "Cifra destacada (tabular)" },
    "amount":    { "size": "{font.size.14}", "leading": "{font.leading.20}", "weight": "{font.weight.medium}", "tracking": "0", "use": "Cifra en línea (tabular)" },
    "ref":       { "size": "0.78125rem", "leading": "{font.leading.18}", "weight": "{font.weight.regular}", "tracking": "0", "use": "Referencias (IBM Plex Mono)" }
  }
}
