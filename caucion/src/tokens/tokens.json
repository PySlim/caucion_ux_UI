  "theme": {
    "light": {
      "bg-canvas": "{color.slate.50}", "bg-surface": "{color.slate.0}", "bg-subtle": "{color.slate.25}", "bg-muted": "{color.slate.100}", "bg-selected": "{color.blue.50}",
      "bg-nav": "{color.navy.900}", "bg-nav-hover": "{color.navy.800}", "bg-nav-active": "{color.navy.700}", "bg-overlay": "{overlay.light}", "bg-inverse": "{color.navy.925}",
      "fg-default": "{color.slate.800}", "fg-muted": "{color.slate.550}", "fg-subtle": "{color.slate.450}",
      "fg-on-nav": "{color.slate.0}", "fg-on-nav-muted": "{color.navy.200}", "fg-on-action": "{color.slate.0}", "fg-on-inverse": "{color.slate.0}", "fg-on-status": "{color.slate.0}",
      "fg-link": "{color.blue.700}", "fg-brand": "{color.navy.900}",
      "border-default": "{color.slate.200}", "border-strong": "{color.slate.450}", "border-nav": "{color.navy.650}", "border-focus": "{color.blue.600}",
      "nav-indicator": "{color.teal.350}", "nav-badge-bg": "{color.teal.100}", "nav-badge-fg": "{color.teal.950}",
      "action": "{color.blue.600}", "action-hover": "{color.blue.700}", "action-active": "{color.blue.800}", "action-soft": "{color.blue.50}", "action-fg": "{color.blue.700}",
      "accent": "{color.teal.600}", "accent-fg": "{color.teal.700}", "accent-soft": "{color.teal.50}",
      "info": "{color.blue.700}", "info-soft": "{color.blue.50}", "review": "{color.violet.700}", "review-soft": "{color.violet.50}",
      "success": "{color.green.700}", "success-soft": "{color.green.50}", "warning": "{color.amber.700}", "warning-soft": "{color.amber.50}",
      "danger": "{color.red.700}", "danger-hover": "{color.red.800}", "danger-soft": "{color.red.50}",
      "neutral": "{color.slate.550}", "neutral-soft": "{color.slate.100}",
      "shadow-color": "{shadowColor.light}", "shadow-alpha-1": "0.06", "shadow-alpha-2": "0.12", "shadow-alpha-3": "0.22"
    },
    "dark": {
      "bg-canvas": "{color.ink.900}", "bg-surface": "{color.ink.800}", "bg-subtle": "{color.ink.750}", "bg-muted": "{color.ink.600}", "bg-selected": "{color.blue.900}",
      "bg-nav": "{color.ink.950}", "bg-nav-hover": "{color.ink.850}", "bg-nav-active": "{color.ink.700}", "bg-overlay": "{overlay.dark}", "bg-inverse": "{color.ink.100}",
      "fg-default": "{color.ink.100}", "fg-muted": "{color.ink.200}", "fg-subtle": "{color.ink.300}",
      "fg-on-nav": "{color.slate.0}", "fg-on-nav-muted": "{color.ink.200}", "fg-on-action": "{color.slate.0}", "fg-on-inverse": "{color.ink.900}", "fg-on-status": "{color.ink.975}",
      "fg-link": "{color.blue.250}", "fg-brand": "{color.ink.100}",
      "border-default": "{color.ink.550}", "border-strong": "{color.ink.400}", "border-nav": "{color.ink.650}", "border-focus": "{color.blue.250}",
      "nav-indicator": "{color.teal.350}", "nav-badge-bg": "{color.teal.350}", "nav-badge-fg": "{color.teal.975}",
      "action": "{color.blue.550}", "action-hover": "{color.blue.650}", "action-active": "{color.blue.750}", "action-soft": "{color.blue.900}", "action-fg": "{color.blue.300}",
