      "info": "{color.blue.250}", "info-soft": "{color.blue.900}", "review": "{color.violet.300}", "review-soft": "{color.violet.950}",
      "success": "{color.green.400}", "success-soft": "{color.green.950}", "warning": "{color.amber.400}", "warning-soft": "{color.amber.950}",
      "danger": "{color.red.400}", "danger-hover": "{color.red.300}", "danger-soft": "{color.red.950}",
      "neutral": "{color.ink.200}", "neutral-soft": "{color.ink.600}",
      "shadow-color": "{shadowColor.dark}", "shadow-alpha-1": "0.35", "shadow-alpha-2": "0.45", "shadow-alpha-3": "0.6"
    }
