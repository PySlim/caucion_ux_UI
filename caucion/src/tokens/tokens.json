{
  "$description": "CAUCIÓN Design System V1.2 — Corporate Refined. FUENTE ÚNICA DE VERDAD. scripts/build-tokens.mjs genera src/tokens/generated/tokens.css y tokens.ts. Referencias: {grupo.subgrupo.clave} apuntan a la capa primitiva.",
  "meta": { "name": "CAUCIÓN Design System", "version": "1.2.0", "identity": "Corporate Refined" },

  "primitive": {
    "color": {
      "navy":   { "925": "#0B1A2E", "900": "#142B49", "800": "#1C3A60", "700": "#26497A", "650": "#2A4064", "200": "#B3C3D8" },
      "ink":    { "975": "#0B1220", "950": "#0A1322", "900": "#0E1726", "850": "#13213A", "800": "#152238", "750": "#182740", "700": "#1C3050", "650": "#1E2D47", "600": "#1F3150", "550": "#26375A", "400": "#6A80A3", "300": "#7487A1", "200": "#A3B4CA", "100": "#E6ECF4" },
      "blue":   { "50": "#EAF1FD", "250": "#8CBBFF", "300": "#A9CBFF", "550": "#2F6AE0", "600": "#2563EB", "650": "#2559C4", "700": "#1D4ED8", "750": "#1F4CAB", "800": "#1E40AF", "900": "#1B3260" },
      "teal":   { "50": "#E7F5F3", "100": "#CCFBF1", "300": "#5ED3C6", "350": "#2DD4BF", "400": "#2BB3A6", "600": "#0D9488", "700": "#0F766E", "900": "#12352F", "950": "#0F3D3A", "975": "#05211F" },
      "slate":  { "0": "#FFFFFF", "25": "#F8FAFC", "50": "#F3F6FA", "100": "#EEF2F6", "200": "#E2E8F0", "450": "#8392A6", "500": "#64748B", "550": "#5B6B80", "800": "#1E293B" },
      "green":  { "50": "#ECF7EF", "400": "#4ADE80", "700": "#15803D", "950": "#11291C" },
      "amber":  { "50": "#FDF4E7", "400": "#F5B14C", "700": "#B45309", "950": "#33250F" },
      "red":    { "50": "#FCEDED", "300": "#FCA5A5", "400": "#F87171", "700": "#B91C1C", "800": "#991B1B", "950": "#3A1717" },
      "violet": { "50": "#F3EEFD", "300": "#C4B0FC", "700": "#6D28D9", "950": "#2A2050" }
