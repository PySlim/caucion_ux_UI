    "overlay": { "light": "rgb(11 26 46 / 0.45)", "dark": "rgb(0 0 0 / 0.6)" },
    "shadowColor": { "light": "20 43 73", "dark": "0 0 0" },
    "radius": { "none": "0px", "xs": "2px", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },
    "space": { "0": "0px", "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
    "font": {
      "family": {
        "sans": "\"IBM Plex Sans\", \"Segoe UI\", system-ui, -apple-system, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace"
      },
      "weight": { "regular": "400", "medium": "500", "semibold": "600" },
      "size": { "11": "0.6875rem", "12": "0.75rem", "13": "0.8125rem", "14": "0.875rem", "16": "1rem", "18": "1.125rem", "20": "1.25rem", "22": "1.375rem", "24": "1.5rem" },
      "leading": { "16": "1rem", "18": "1.125rem", "20": "1.25rem", "24": "1.5rem", "26": "1.625rem", "28": "1.75rem", "32": "2rem" }
    },
    "duration": { "fast": "100ms", "base": "160ms" }
  },

